# MEDUCID Environment Variables Example
# Copy this file to .env.local for local development, or add these in your Vercel Project Settings under Environment Variables.

# Gemini API Configuration (Comma-separated keys for auto-rotation, or single key)
GEMINI_API_KEYS=your_gemini_api_key_here

# Google OAuth Authentication (from Google Cloud Console)
# Authorized redirect URI: https://your-deployment-domain.vercel.app/api/auth/callback/google
# Local redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Session Cookie Signing Secret
SESSION_SECRET=your-random-long-session-secret-string

# Cloudflare D1 Edge Database
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
CLOUDFLARE_D1_DATABASE_ID=your_d1_database_uuid
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token
